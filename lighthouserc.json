{
  "ci": {
    "collect": { "startServerCommand": "npm run preview", "startServerReadyPattern": "Local", "url": ["http://localhost:4173/welcome"], "numberOfRuns": 1, "settings": { "preset": "desktop" } },
    "assert": { "assertions": {
      "categories:performance": ["error", { "minScore": 0.85 }],
      "categories:accessibility": ["error", { "minScore": 0.95 }],
      "categories:best-practices": ["warn", { "minScore": 0.9 }]
    } }
  }
}
