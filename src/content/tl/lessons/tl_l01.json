{
  "id": "tl_l01",
  "contentVersion": 1,
  "title": "Salutations et politesse",
  "description": "Dis bonjour à toute heure, remercie et prends congé. Et surtout, apprends « po » : le petit mot qui rend tout poli.",
  "tagline": "Saluer poliment",
  "emoji": "👋",
  "dialogueId": "tl_d01",
  "vocab": [
    {
      "id": "tl_v_kumusta",
      "vi": "kumusta",
      "fr": "comment ça va ? / salut",
      "dialect": "manila",
      "pron": "ku·mus·TA",
      "note": "Le salut de tous les jours, de l'espagnol « cómo está ». « Kumusta ka? » à un ami, « Kumusta po kayo? » à un inconnu ou à un aîné."
    },
    {
      "id": "tl_v_mabuti",
      "vi": "mabuti",
      "fr": "bien",
      "dialect": "manila",
      "pron": "ma·BU·ti"
    },
    {
      "id": "tl_v_mabuti_naman",
      "vi": "mabuti naman",
      "fr": "ça va bien",
      "dialect": "manila",
      "pron": "ma·BU·ti na·MAN",
      "note": "La réponse habituelle à « Kumusta? ». « Naman » adoucit la phrase."
    },
    {
      "id": "tl_v_ka",
      "vi": "ka",
      "fr": "tu",
      "dialect": "manila",
      "pron": "KA",
      "note": "À un ami ou à quelqu'un de ton âge : « Kumusta ka? »."
    },
    {
      "id": "tl_v_kayo",
      "vi": "kayo",
      "fr": "vous (poli)",
      "dialect": "manila",
      "pron": "ka·YO",
      "note": "Avec « po », pour un aîné, un vendeur ou un chauffeur : « Kumusta po kayo? »."
    },
    {
      "id": "tl_v_po",
      "vi": "po",
      "fr": "marque de respect",
      "dialect": "manila",
      "pron": "PO",
      "note": "Le mot le plus utile du voyage. On le glisse dans la phrase pour parler poliment à un inconnu, un vendeur, un chauffeur ou un aîné : « Salamat po. » Dans le doute, mets « po »."
    },
    {
      "id": "tl_v_opo",
      "vi": "opo",
      "fr": "oui (poli)",
      "dialect": "manila",
      "pron": "O·po",
      "note": "Le oui respectueux, à dire à un inconnu ou à un aîné."
    },
    {
      "id": "tl_v_oo",
      "vi": "oo",
      "fr": "oui",
      "dialect": "manila",
      "pron": "O·o",
      "note": "Entre amis. À un inconnu, dis plutôt « opo »."
    },
    {
      "id": "tl_v_hindi",
      "vi": "hindi",
      "fr": "non",
      "dialect": "manila",
      "pron": "hin·DI",
      "note": "Poliment : « Hindi po »."
    },
    {
      "id": "tl_v_salamat",
      "vi": "salamat",
      "fr": "merci",
      "dialect": "manila",
      "pron": "sa·LA·mat",
      "note": "Poliment : « Salamat po »."
    },
    {
      "id": "tl_v_maraming_salamat",
      "vi": "maraming salamat",
      "fr": "merci beaucoup",
      "dialect": "manila",
      "pron": "ma·RA·ming sa·LA·mat"
    },
    {
      "id": "tl_v_walang_anuman",
      "vi": "walang anuman",
      "fr": "de rien",
      "dialect": "manila",
      "pron": "wa·LANG a·nu·MAN"
    },
    {
      "id": "tl_v_magandang_umaga",
      "vi": "magandang umaga",
      "fr": "bonjour (le matin)",
      "dialect": "manila",
      "pron": "ma·gan·DANG u·MA·ga",
      "note": "Mot à mot « beau matin ». Avec « po » pour un inconnu : « Magandang umaga po! »."
    },
    {
      "id": "tl_v_magandang_hapon",
      "vi": "magandang hapon",
      "fr": "bon après-midi",
      "dialect": "manila",
      "pron": "ma·gan·DANG HA·pon",
      "note": "L'après-midi, pour saluer en arrivant."
    },
    {
      "id": "tl_v_magandang_gabi",
      "vi": "magandang gabi",
      "fr": "bonsoir",
      "dialect": "manila",
      "pron": "ma·gan·DANG ga·BI",
      "note": "Le soir, pour saluer en arrivant."
    },
    {
      "id": "tl_v_paalam",
      "vi": "paalam",
      "fr": "au revoir",
      "dialect": "manila",
      "pron": "pa·A·lam",
      "note": "Un peu solennel. Au quotidien, on se quitte plutôt avec « Ingat! » ou même « Bye! » en anglais."
    },
    {
      "id": "tl_v_ingat",
      "vi": "ingat",
      "fr": "prends soin de toi (en se quittant)",
      "dialect": "manila",
      "pron": "I·ngat",
      "note": "Le vrai au revoir de tous les jours : « Ingat! », ou « Ingat po! » pour un aîné."
    }
  ],
