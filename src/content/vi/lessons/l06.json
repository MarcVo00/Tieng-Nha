      "fr": "assiette",
      "dialect": "south",
      "note": "Au Nord on dit « đĩa » ; attention, au Nord « dĩa » veut dire « fourchette »."
    },
    {
      "id": "v_ngon_qua",
      "vi": "ngon quá",
      "fr": "que c'est bon !",
      "dialect": "south",
      "note": "« Quá » renforce l'adjectif : « ngon quá ! » = « délicieux ! »."
    }
  ],
