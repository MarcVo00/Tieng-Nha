      "dialect": "south"
    },
    {
      "id": "v_doi",
      "vi": "đói",
      "fr": "avoir faim",
      "dialect": "south",
      "note": "À l'oral, on dit souvent juste « Đói quá ! » (j'ai trop faim), sans « je »."
    },
    {
      "id": "v_no",
      "vi": "no",
      "fr": "être rassasié",
      "dialect": "south",
      "note": "Attention : « no » veut dire « avoir assez mangé », pas « non » (non se dit « không »)."
    },
    {
      "id": "v_chen",
      "vi": "chén",
      "fr": "bol",
      "dialect": "south",
      "note": "Au Nord on dit « bát »."
    },
