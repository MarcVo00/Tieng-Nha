  "title": "Manger",
  "description": "Parle de nourriture : les plats qu'on mange partout à Sài Gòn (phở, cơm tấm, bánh mì, hủ tiếu), les verbes manger et boire, et les couverts.",
  "tagline": "Phở, bánh mì",
  "emoji": "🍜",
  "dialogueId": "d06",
  "vocab": [
    {
      "id": "v_pho",
      "vi": "phở",
      "fr": "phở (soupe de nouilles de riz)",
      "dialect": "south",
      "note": "Le plat le plus connu du Vietnam : bouillon, nouilles de riz et viande."
    },
    {
      "id": "v_com_tam",
      "vi": "cơm tấm",
      "fr": "riz brisé (avec porc grillé)",
      "dialect": "south",
      "note": "Plat typique de Sài Gòn : du riz brisé servi avec du porc grillé."
    },
    {
      "id": "v_banh_mi",
      "vi": "bánh mì",
      "fr": "sandwich vietnamien (baguette)",
      "dialect": "south"
    },
    {
