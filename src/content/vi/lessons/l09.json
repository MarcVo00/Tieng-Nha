    {
      "id": "v_gio",
      "vi": "giờ",
      "fr": "heure",
      "dialect": "south",
      "note": "À l'oral du Sud, « gi » se prononce comme un « y ». Le nombre précède « giờ » : « tám giờ » = huit heures."
    },
    {
      "id": "v_may_gio",
      "vi": "mấy giờ",
      "fr": "quelle heure ?",
      "dialect": "south",
      "note": "Pour demander l'heure, on dit « Mấy giờ rồi ? » (mot à mot : « combien d'heures déjà ? »), et on répond « Ba giờ rồi » (il est trois heures). « Bây giờ là mấy giờ ? » est la forme des manuels."
    },
    {
      "id": "v_sang",
      "vi": "sáng",
      "fr": "matin",
      "dialect": "south",
      "note": "On place le moment de la journée après l'heure : « tám giờ sáng » = huit heures du matin."
    },
    {
      "id": "v_trua",
      "vi": "trưa",
      "fr": "midi, début d'après-midi",
      "dialect": "south"
    },
    {
      "id": "v_chieu",
      "vi": "chiều",
      "fr": "après-midi, fin d'après-midi",
      "dialect": "south",
      "note": "« Ba giờ chiều » = trois heures de l'après-midi."
    },
    {
      "id": "v_toi_soir",
      "vi": "tối",
      "fr": "soir",
      "dialect": "south"
    },
    {
      "id": "v_gap",
      "vi": "gặp",
      "fr": "rencontrer, voir (quelqu'un)",
      "dialect": "south",
      "note": "« Gặp bạn ngày mai nha » = « On se voit demain »."
    }
  ],
